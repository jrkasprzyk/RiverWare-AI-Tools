# RiverWare_Model 9.4
# Created 11:43 January 28, 2025
# CADSWES, University of Colorado at Boulder, http://cadswes.colorado.edu/
# 
# The catalog command is parsed by RiverWare and RiverSMART:
#  - It must appear in the first 100 lines of the file.
#  - Lines up to and including it must not exceed 4K bytes.
#  - Its name must not change.
Catalog {\
<Catalog>\
 <SimWorkspace><ModelLockSet value="0"></ModelLockSet>\
  <AutoSave notifyType="none" saveDir="." saveInterval="15" saveModelFile="0" saveOutputs="0"></AutoSave>\
 </SimWorkspace>\
 <DiagMgr infoDiag="1"></DiagMgr>\
 <MRMControl><mrmCfgList><mrmCfg name="Arbor Basin Baseline MRM" numTrace="20" traceMode="Traces"><descriptorList></descriptorList>\
    <NetCDF></NetCDF>\
    <CSV></CSV>\
   </mrmCfg>\
   <mrmCfg name="Arbor Basin Increased Transbasin MRM" numTrace="20" traceMode="Traces"><descriptorList></descriptorList>\
    <NetCDF></NetCDF>\
    <CSV></CSV>\
   </mrmCfg>\
   <mrmCfg name="Arbor Basin Divert Only Excess MRM" numTrace="20" traceMode="Traces"><descriptorList></descriptorList>\
    <NetCDF></NetCDF>\
    <CSV></CSV>\
   </mrmCfg>\
   <mrmCfg name="Two Runs"><ptoDmi name="To Borg-RiverWare MRM Run" type="execDmi"></ptoDmi>\
    <descriptorList></descriptorList>\
    <NetCDF></NetCDF>\
    <CSV></CSV>\
   </mrmCfg>\
   <mrmCfg name="Two Runs Distributed" numTrace="2" traceMode="Traces"><ptoDmi name="To Borg-RiverWare MRM Run" type="execDmi"></ptoDmi>\
    <descriptorList></descriptorList>\
    <NetCDF></NetCDF>\
    <CSV></CSV>\
   </mrmCfg>\
  </mrmCfgList>\
 </MRMControl>\
 <DmiMgr><datasetList><dataset name="ReservoirOutputDataset" type="Excel"><workbook>${RW_TRAINING_OUT}/DMIOutput/ArborOutputData.xlsx</workbook>\
    <sheet>Reservoirs</sheet>\
   </dataset>\
   <dataset name="ArborInputs2018" type="Excel"><workbook>${RW_TRAINING_ADV}/ModelsAndData/ArborBasin_Data.xlsx</workbook>\
    <sheet>2018Input</sheet>\
   </dataset>\
   <dataset name="GageOutputDataset" type="Excel"><workbook>${RW_TRAINING_OUT}/DMIOutput/ArborOutputData.xlsx</workbook>\
    <sheet>Gages</sheet>\
   </dataset>\
   <dataset name="ArborMRMInputsDataset" type="Excel"><workbook>${RW_TRAINING_ADV}/ModelsAndData/MRM/ArborBasin_MRMData.xlsx</workbook>\
   </dataset>\
  </datasetList>\
  <dmiList><dbDmi datasets="Excel" name="ArborOutputs" type="output"><datasets>ReservoirOutputDataset,GageOutputDataset</datasets>\
   </dbDmi>\
   <dbDmi datasets="Excel" name="ArborInputDMI" type="input"><datasets>ArborInputs2018</datasets>\
   </dbDmi>\
   <execDmi name="ArborOutputToText" type="output"></execDmi>\
   <dbDmi datasets="Excel" name="ArborMRMInputs" type="input"><datasets>ArborMRMInputsDataset</datasets>\
   </dbDmi>\
   <execDmi name="To Borg-RiverWare MRM Run" type="output"></execDmi>\
   <execDmi name="From Borg-RiverWare" type="input"></execDmi>\
   <execDmi name="To Borg-RiverWare Single Run" type="output"></execDmi>\
  </dmiList>\
 </DmiMgr>\
 <RplApplication><rplSetList><rplSetInfo rplSetName="Arbor Basin Rules (from MRM run)" rplSetType="Rule Based Simulation"></rplSetInfo>\
   <rplSetInfo rplSetName="Arbor Basin Functions" rplSetType="Global Functions"></rplSetInfo>\
   <rplSetInfo rplSetName="Initialization Rules Set" rplSetType="Initialization Rules"></rplSetInfo>\
   <rplSetInfo rplSetName="Expression Slot Functions Set" rplSetType="Expression Slots"></rplSetInfo>\
   <rplSetInfo rplSetName="Iterative MRM Rules Set" rplSetType="MRM Rules"></rplSetInfo>\
  </rplSetList>\
 </RplApplication>\
 <WindowLayoutManager><WindowLayouts><WindowLayout Name="Window Layout 1"></WindowLayout>\
  </WindowLayouts>\
 </WindowLayoutManager>\
 <ScriptManager><Scripts></Scripts>\
  <ScriptGroups></ScriptGroups>\
 </ScriptManager>\
</Catalog>\
} # End Catalog
