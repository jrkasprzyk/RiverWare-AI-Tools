# Section: Optimization Set Manager
Section {Optimization Set Manager}
set mgr "$ws.optSetMgr"
# Section: Optimization
Section {Optimization}
$ws.RplBasedOptController ShouldExecInitRules 0
$ws.RplBasedOptController ShouldRunFromRestorePoint 0
$ws.RplBasedOptController RunFromRestorePointName {}
$ws.RplBasedOptController savePolicyWithModel 1
$ws.RplBasedOptController setParameter {ADVANCE 2}
$ws.RplBasedOptController setParameter {BARRIER CROSSOVER 1}
$ws.RplBasedOptController setParameter {PREPROCESSING AGGREGATOR 10}
$ws.RplBasedOptController setParameter {PREPROCESSING DUAL -1}
$ws.RplBasedOptController setParameter {PREPROCESSING REDUCE 1}
$ws.RplBasedOptController setParameter {SIMPLEX PGRADIENT 4}
$ws.RplBasedOptController setParameter {SIMPLEX TOLERANCES MARKOWITZ 5.000000e-01}
$ws.RplBasedOptController setParameter {SIMPLEX TOLERANCES FEASIBILITY 1.000000e-09}
$ws.RplBasedOptController setParameter {SIMPLEX DISPLAY 0}
$ws.RplBasedOptController setParameter {TIMELIMIT 3.000000e+03}
$ws.RplBasedOptController setParameter {LPMETHOD 1}
$ws.RplBasedOptController setParameter {KAPPA 1}
$ws.RplBasedOptController setParameter {QUALITY 1}
# Section: Simulation Controller
Section {Simulation Controller}
$ws.SimControl ShouldExecInitRules 0
# Section: Rule Controller
Section {Rule Controller}
$ws.RuleControl ShouldExecInitRules 1
$ws.RuleControl MaxRuleExecCount 1000
# Section: Initialization Rules
Section {Initialization Rules}
$ws initRules {RULESET\
NAME "Initialization Rules Set";\
AGENDA_ORDER ASCENDING;\
DESCRIPTION "";\
PRECISION   2;\
NOTES "";\
BEGIN\
\
  POLICY_GROUP   "Transbasin Diversion";\
  DESCRIPTION    "";\
  ACTIVE         TRUE;\
  NOTES          "";\
  BEGIN\
\
    RULE                 " Trace Diversion Schedule Variation";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    SET_VALUE_FLAG       64;\
    NOTES                "";\
    BEGIN\
\
      IF_STATEMENT ("GetTraceNumber"(  ) == 1.00000000) THEN\
            FOREACH (DATETIME t IN @"Start Timestep" TO @"Finish Timestep") DO\
            $ "Transbasin Diversion.Diversion Request" [t] := $ "Transbasin Diversion.Diversion Request" [t] * 0.90000000;\
\
      ENDFOREACH;\
\
      END_IF_STATEMENT;\
\
    END\
    UUID "{5a9acb09-0483-43a3-8e05-7715cdbf4de5}";;\
\
    RULE                 "Convert Monthly Diversion Schedule to Daily Diversion Request";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    SET_VALUE_FLAG       64;\
    NOTES                "";\
    BEGIN\
\
      FOREACH (DATETIME t IN @"Start Timestep" TO @"Finish Timestep") DO\
            $ "Transbasin Diversion.Diversion Request" [t] := $ "Transbasin Diversion.Diversion Schedule Monthly" [t] / "GetDaysInMonth"( t );\
\
      ENDFOREACH;\
\
    END\
    UUID "{eb34a67e-897c-44d4-a8cc-8236c11c7001}";;\
\
  END\
  UUID "{17052951-22c1-47d3-a66d-b9667832be66}";;\
\
  POLICY_GROUP   "Hickroy Diversion";\
  DESCRIPTION    "";\
  ACTIVE         TRUE;\
  NOTES          "";\
  BEGIN\
\
    RULE                 "Convert Hickory Monthly Diversion Schedule to Daily Diversion Request";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    SET_VALUE_FLAG       64;\
    NOTES                "";\
    BEGIN\
\
      FOREACH (DATETIME t IN @"Start Timestep" TO @"Finish Timestep") DO\
            $ "Hickory Diversion.Diversion Request" [t] := $ "Hickory Diversion.Diversion Schedule Monthlly" [t] / "GetDaysInMonth"( t );\
\
      ENDFOREACH;\
\
    END\
    UUID "{c33432f9-26ee-4fdc-b186-bfdef96f9b20}";;\
\
  END\
  UUID "{5af19f1b-0989-4fb8-9bd1-831a6cf4bf13}";;\
\
END\
UUID "{7078c900-264a-4bcd-b15b-84a8b86aa78a}";\
}
$ws initRulesSetValueMapCmd {Hickory Diversion.Diversion Request} 1 - 365 3 
$ws initRulesSetValueMapCmd {Transbasin Diversion.Diversion Request} 1 - 365 1 
# Section: RPL Display Settings
