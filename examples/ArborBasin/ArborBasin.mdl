# Section: Global Functions Set Manager
Section {Gobal Functions Set Manager}
$ws.GlobalRplSetMgr saveSetsWithModel
$ws.GlobalRplSetMgr globalFunctionSet {RULESET\
NAME "Arbor Basin Functions";\
AGENDA_ORDER ASCENDING;\
DESCRIPTION "";\
PRECISION   2;\
IS_GLOBAL   TRUE;\
NOTES "";\
BEGIN\
\
  UTILITY_GROUP "Utility Group";\
  DESCRIPTION   "";\
  ACTIVE        TRUE;\
  NOTES          "";\
  BEGIN\
\
    FUNCTION       "OutflowForMinOutflowRules" ( OBJECT res )\
    RETURN_TYPE    NUMERIC;\
    SCALE_UNITS    "";\
    DESCRIPTION    "";\
    ACTIVE         TRUE;\
    PRE_EXEC_DIAG  FALSE;\
    POST_EXEC_DIAG FALSE;\
    NOTES          "";\
    BEGIN\
\
      "Max"( "MinItem"( { res & "Outflow Min" [] , "SolveOutflow"( res, res & "Inflow" [], res & "Elevation Volume Table" [0.00000000, 1.00000000] + 1.00000000 "m3", res & "Storage" [@"t - 1"], @"t" ) , "GetMaxOutflowGivenInflow"( res, res & "Inflow" [], @"t" ) } ), "SolveOutflow"( res, res & "Inflow" [], res & "Elevation Volume Table" ["NumRows"( res & "Elevation Volume Table" ) - 1.00000000, 1.00000000], res & "Storage" [@"t - 1"], @"t" ) );\
\
    END\
    UUID "{683ca468-1a26-4a06-9eeb-69ccb854a72e}";;\
\
    FUNCTION       "OutflowForMinElevationRules" ( OBJECT res )\
    RETURN_TYPE    NUMERIC;\
    SCALE_UNITS    "";\
    DESCRIPTION    "";\
    ACTIVE         TRUE;\
    PRE_EXEC_DIAG  FALSE;\
    POST_EXEC_DIAG FALSE;\
    NOTES          "";\
    BEGIN\
\
      "Max"( "SolveOutflow"( res, res & "Inflow" [], "ElevationToStorage"( res, res & "Pool Elevation Min" [] ), res & "Storage" [@"t - 1"], @"t" ), 0.00000000 "cms" );\
\
    END\
    UUID "{b14b5366-a804-4781-91ff-e2d644c4efd6}";;\
\
    FUNCTION       "OutflowForMaxElevationRules" ( OBJECT res )\
    RETURN_TYPE    NUMERIC;\
    SCALE_UNITS    "";\
    DESCRIPTION    "";\
    ACTIVE         TRUE;\
    PRE_EXEC_DIAG  FALSE;\
    POST_EXEC_DIAG FALSE;\
    NOTES          "";\
    BEGIN\
\
      "Min"( "SolveOutflow"( res, res & "Inflow" [], "ElevationToStorage"( res, res & "Pool Elevation Max" [] ), res & "Storage" [@"t - 1"], @"t" ), "GetMaxOutflowGivenInflow"( res, res & "Inflow" [], @"t" ) );\
\
    END\
    UUID "{e429d54a-8f77-47e9-a002-e37fe7d0061a}";;\
\
  END\
  UUID "{724875a2-bdc1-4d1b-ab64-8ed394d9715e}";;\
\
END\
UUID "{7564dc93-bbbd-44aa-b3d4-a657eaaaf674}";\
}
# Section: RuleSet Manager
Section {RuleSet Manager}
set rsm "$ws.RulesetMgr"
$rsm saveLoadedSetWithModel
$rsm loadedSet {RULESET\
NAME "Arbor Basin Rules (from MRM run)";\
AGENDA_ORDER ASCENDING;\
DESCRIPTION "";\
PRECISION   2;\
NOTES "";\
BEGIN\
\
  POLICY_GROUP   "Post-processing";\
  DESCRIPTION    "";\
  ACTIVE         TRUE;\
  NOTES          "";\
  BEGIN\
\
    RULE                 "Energy Cumulative";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      FOREACH (OBJECT res IN "ListSubbasin"( "PowerReservoir" ) SET_UNION { % "Mulberry Canal Power" }) DO\
            res & "Energy Cumulative" [] := "SumSlot"( res & "Energy", @"Start Timestep", @"t" );\
\
      ENDFOREACH;\
\
    END\
    UUID "{28cc2157-959c-4bd4-895d-3a1f187cbbb6}";;\
\
    RULE                 "System Spill";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      $ "System Data.Spill Volume" [] := FOR ( OBJECT res IN "ListSubbasin"( "Reservoir" ) ) STAT_SUM\
  "FlowToVolume"( res & "Spill" [], @"t" )\
 ENDFOR;\
\
    END\
    UUID "{370c8185-4edd-4872-bf1a-843707cd808a}";;\
\
    RULE                 "System Depletion Shortage";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      $ "System Data.Depletion Shortage" [] := FOR ( OBJECT res IN "ListSubbasin"( "WaterUser" ) ) STAT_SUM\
  "FlowToVolume"( res & "Depletion Shortage" [], @"t" )\
 ENDFOR;\
\
    END\
    UUID "{4b88ff26-d6a9-4f28-a223-77b7d426f893}";;\
\
    RULE                 "System Energy";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      $ "System Data.Energy" [] := FOR ( OBJECT res IN "ListSubbasin"( "PowerReservoir" ) SET_UNION { % "Mulberry Canal Power" } ) STAT_SUM\
  res & "Energy" []\
 ENDFOR;\
\
    END\
    UUID "{3b5fec82-df5b-4b11-af97-1d8d0b6b7a38}";;\
\
    RULE                 "Interstate Flow Requirement Violation";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      $ "Interstate Flow Requirement.Min Flow Violation" [] := WITH NUMERIC minFlow = "Min"( $ "Interstate Flow Requirement.Min Flow" [], $ "Gage Above Hickory.Gage Inflow" [] ) DO\
  IF ( $ "Interstate Flow Requirement.Gage Outflow" [] < minFlow - 0.10000000 "cms" )\
  THEN\
   minFlow - $ "Interstate Flow Requirement.Gage Outflow" []\
  ELSE\
   0.00000000 "cms"\
  ENDIF\
 ENDWITH;\
\
    END\
    UUID "{b7669c6d-55fa-4464-b058-dc4ad3721473}";;\
\
  END\
  UUID "{5254abc3-ee68-450e-892a-2da655667198}";;\
\
  POLICY_GROUP   "Hickory Rules";\
  DESCRIPTION    "";\
  ACTIVE         TRUE;\
  NOTES          "";\
  BEGIN\
\
    RULE                 "Hickory Elevation Max";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      WITH_STATEMENT (OBJECT res = % "Hickory") DO\
            res & "Outflow" [] := IF ( res & "Pool Elevation" [] > res & "Pool Elevation Max" [] )\
 THEN\
  "OutflowForMaxElevationRules"( res )\
 ENDIF;\
\
      END_WITH_STATEMENT;\
\
    END\
    UUID "{c4db58eb-653e-40c1-a90d-2bf48cbb906b}";;\
\
    RULE                 "Hickory Elevation Min";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      WITH_STATEMENT (OBJECT res = % "Hickory") DO\
            res & "Outflow" [] := IF ( res & "Pool Elevation" [] < res & "Pool Elevation Min" [] )\
 THEN\
  "OutflowForMinElevationRules"( res )\
 ENDIF;\
\
      END_WITH_STATEMENT;\
\
    END\
    UUID "{92f65424-877f-4102-823b-c7309763556c}";;\
\
    RULE                 "Hickory Elevation Min Reduce Diversion";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      IF_STATEMENT ($ "Hickory.Pool Elevation" [] < $ "Hickory.Pool Elevation Min" []) THEN\
            WITH_STATEMENT (NUMERIC diversionReduction = "Min"( "VolumeToFlow"( "ElevationToStorage"( % "Hickory", $ "Hickory.Pool Elevation Min" [] ) - $ "Hickory.Storage" [], @"t" ), $ "Hickory Diversion.Diversion Request" [] )) DO\
            $ "Hickory Diversion.Diversion Request" [] := $ "Hickory Diversion.Diversion Request" [] - diversionReduction;\
\
      END_WITH_STATEMENT;\
\
      END_IF_STATEMENT;\
\
    END\
    UUID "{a2669ea5-90ec-4c43-b7b1-77916a1bd5fc}";;\
\
    RULE                 "Reduce Hickory Diversion";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      IF_STATEMENT ($ "Juniper Irrigation.Total Diversion" [] < $ "Juniper Irrigation.Total Diversion Requested" []) THEN\
            WITH_STATEMENT (NUMERIC diversionReduction = "Min"( $ "Juniper Irrigation.Total Diversion Requested" [] - $ "Juniper Irrigation.Total Diversion" [], $ "Hickory Diversion.Diversion Request" [] )) DO\
            $ "Hickory Diversion.Diversion Request" [] := $ "Hickory Diversion.Diversion Request" [] - diversionReduction;\
\
            $ "Hickory.Outflow" [] := $ "Hickory.Outflow" [] + diversionReduction;\
\
      END_WITH_STATEMENT;\
\
            WARNING_STATEMENT "Reducing Hickory Diversion to help meet Juniper Irrigation priority rights.";\
\
      END_IF_STATEMENT;\
\
    END\
    UUID "{cd4831ad-f8be-4f60-861b-0a2d3f0829b1}";;\
\
    RULE                 "Supplement Juniper from Hickory Storage";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      $ "Hickory.Outflow" [] := IF ( $ "Juniper Irrigation.Total Diversion" [] < $ "Juniper Irrigation.Total Diversion Requested" [] AND $ "Hickory.Pool Elevation" [] > $ "Hickory.Pool Elevation Min to Supplement Irrigation" [] )\
 THEN\
  $ "Hickory.Outflow" [] + "Min"( $ "Juniper Irrigation.Total Diversion Requested" [] - $ "Juniper Irrigation.Total Diversion" [], "VolumeToFlow"( $ "Hickory.Storage" [] - "ElevationToStorage"( % "Hickory", $ "Hickory.Pool Elevation Min to Supplement Irrigation" [] ), @"t" ) )\
 ENDIF;\
\
    END\
    UUID "{976bee91-aea1-4d80-8a16-4df9d1034453}";;\
\
    RULE                 "Hickory Pass Natural Flows for Juniper and Interstate";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      $ "Hickory.Outflow" [] := "MinItem"( { $ "Gage Above Hickory.Gage Inflow" [] , $ "Interstate Flow Requirement.Min Flow" [] + $ "Juniper Irrigation.Total Diversion Requested" [] , "GetMaxReleaseGivenInflow"( % "Hickory", $ "Hickory.Inflow" [], @"t" ) } );\
\
    END\
    UUID "{1a4cdf1e-6b77-4d92-b595-0867a636e743}";;\
\
    RULE                 "Interstate Flow Requirement";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      $ "Juniper Diversion.Minimum Diversion Bypass" [] := "Min"( $ "Interstate Flow Requirement.Min Flow" [], $ "Gage Above Hickory.Gage Inflow" [] );\
\
    END\
    UUID "{5660f9fc-6f9c-4763-8d20-05914b1458f5}";;\
\
  END\
  UUID "{1b1e6fc8-2c2b-4504-8241-e62d2ae7d1a9}";;\
\
  POLICY_GROUP   "Elm Rules";\
  DESCRIPTION    "";\
  ACTIVE         TRUE;\
  NOTES          "";\
  BEGIN\
\
    RULE                 "Elm Elevation Max";\
    DESCRIPTION          "";\
    ACTIVE               TRUE;\
    RULE_EXEC_CONSTRAINT TRUE;\
    NOTES                "";\
    BEGIN\
\
      WITH_STATEMENT (OBJECT res = % "Elm") DO\
            res & "Outflow" [] := IF ( res & "Pool Elevation" [] > res & "Pool Elevation Max" [] )\
 THEN\
