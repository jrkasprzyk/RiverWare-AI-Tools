# Section: Script Manager
Section {Script Manager}
# Show Script Manager On Model Load
$ws.rwScriptMgr rwShowScriptMgrOnModelLoad {\
<ShowScriptMgrOnModelLoad>\
   <YesOrNo>false</YesOrNo>\
   <DefaultScriptGroup>All Scripts</DefaultScriptGroup>\
   <ResizeToTabs count="0"/>\
</ShowScriptMgrOnModelLoad>\
}
# Run Script Group On Model Load
$ws.rwScriptMgr rwRunScriptGroupOnModelLoad {\
<RunScriptGroupOnModelLoad>\
   <YesOrNo>false</YesOrNo>\
   <RunScriptGroup></RunScriptGroup>\
</RunScriptGroupOnModelLoad>\
}
# Section: Object Attribute Manager
Section {Object Attribute Manager}
# Section: Object Attribute Set
"$ws.objectAttribMgr" objectAttribSet { \
<ObjAttributeSet> \
 <ObjAttribute defaultVal="Federal" name="Fed or NonFed"> \
  <attribValue value="Federal"/> \
  <attribValue value="Nonfederal"/> \
  <simObj type="LevelPowerReservoir"/> \
 </ObjAttribute> \
 <ObjAttribute defaultVal="Chelan" name="PUD"> \
  <attribValue value="Chelan"/> \
  <attribValue value="Douglas"/> \
  <attribValue value="Federal"/> \
  <attribValue value="Grant"/> \
  <simObj type="LevelPowerReservoir"/> \
 </ObjAttribute> \
</ObjAttributeSet>}
# Section: Comparison Tool
"$ws.comparisonTool" modelFilter {\
<Filter Type="model">\
    <OnlyDifferences Value="true"/>\
    <MatchSpecs/>\
</Filter>}
"$ws.comparisonTool" rplFilter {\
<Filter Type="rpl">\
    <OnlyDifferences Value="true"/>\
    <MatchSpecs/>\
</Filter>}
